# Copy to .env and fill in keys before running LangChain Academy notebooks.
# Academy modules 1–5 expect OpenAI + LangSmith. Module 4 also uses Tavily.

OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=langchain-academy
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

TAVILY_API_KEY=

# Hindsight AI Memory (set base URL to local instance or cloud)
HINDSIGHT_API_URL=http://127.0.0.1:8890
HINDSIGHT_BANK_ID=neeraj-patty


